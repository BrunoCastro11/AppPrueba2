<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permiso para realizar llamadas (botón "Llamar a soporte"). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- required="false": la app también se instala en dispositivos sin telefonía. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppPrueba">
        <!-- Primera pantalla: bienvenida. -->
        <activity
            android:name=".BienvenidaActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppPrueba">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de inicio de sesión. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppPrueba"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla de registro de usuarios. -->
        <activity
            android:name=".RegistroActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppPrueba"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla para editar los datos del usuario. -->
        <activity
            android:name=".EditarActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppPrueba"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla a la que se llega después de iniciar sesión. -->
        <activity
            android:name=".InicioActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppPrueba" />
    </application>

</manifest>